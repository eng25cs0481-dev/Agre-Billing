{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@agre/shared/*": ["../shared/src/*"],
      "@agre/shared": ["../shared/src/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src/**/*", "../shared/src/**/*"],
  "exclude": ["../shared/src/**/*.test.ts"]
}
