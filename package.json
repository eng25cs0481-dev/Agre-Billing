{
  "name": "agre-billing",
  "version": "1.0.0",
  "private": true,
  "description": "Agre Billing — Shop billing and business management application",
  "workspaces": [
    "shared",
    "desktop",
    "mobile"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=desktop",
    "dev:mobile": "npm run dev --workspace=mobile",
